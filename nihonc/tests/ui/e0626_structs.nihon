構造体 点 {
    x: 整32,
    y: 整32,
}

実装 点 {
    関数 新() -> 点 { 点 { x: 0, y: 0 } }
    関数 動く(&可変 自分) { 自分.x += 1; }
    関数 見る(&自分) { 自分.x = 3; }
}

関数 f(p: &点) { p.x = 1; }

関数 主() {
    束縛 p = 点 { x: 1 };
    束縛 q = 点 { x: 1, y: 2, z: 3 };
    束縛 r = 点::新();
    r.動く();
    束縛 s = 点 { x: 1, y: 2 };
    s.x = 5;
    表示!("{}", s);
    表示!("{}", s.w);
    束縛 t = s == s;
    s.新();
    点::無し();
    f(s);
    1 = 2;
    束縛 u = &5;
    自分;
}
