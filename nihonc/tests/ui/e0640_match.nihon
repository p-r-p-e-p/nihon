列挙型 色 { 赤, 緑, 青 }
列挙型 形 { 円(実64), 四角(実64, 実64) }
列挙型 木 { 葉, 節(木) }
列挙型 重複 { あ, あ }

関数 a(c: 色) -> 整32 {
    照合 c {
        色::赤 => 1,
        色::緑 => 2,
    }
}

関数 b(f: 形, n: 整32, c: 色) {
    照合 f {
        形::円(r) => 表示!("{}", r),
        形::四角(w) => 表示!("{}", w),
    }
    照合 n {
        1 => 表示!("um"),
    }
    照合 c {
        色::赤 => 表示!("r"),
        _ => 表示!("o"),
        色::青 => 表示!("b"),
    }
    照合 c {
        形::円(_) => 表示!("x"),
        色::黒 => 表示!("y"),
        1 => 表示!("z"),
        _ => {}
    }
    照合 c {
        色::赤 => 1,
        _ => "a",
    };
    照合 f {
        形::円(a) | 形::四角(a, _) => {}
        _ => {}
    }
    束縛 q = 色::赤 == 色::青;
    表示!("{}", 色::緑);
    束縛 p = 形::円;
    束縛 z = 色::赤(1);
    照合 1.5 { _ => {} }
    照合 n { 5..=1 => {}, _ => {} }
}

関数 主() {}
