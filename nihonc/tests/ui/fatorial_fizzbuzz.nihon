関数 階乗(n: 整32) -> 整32 {
    もし n <= 1 {
        返却 1;
    }
    n * 階乗(n - 1)
}

関数 主() {
    各 i 中 1..=15 {
        もし i % 15 == 0 {
            表示!("FizzBuzz");
        } 他もし i % 3 == 0 {
            表示!("Fizz");
        } 他もし i % 5 == 0 {
            表示!("Buzz");
        } 他 {
            表示!("{}", 階乗(i));
        }
    }
}
