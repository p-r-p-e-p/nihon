列挙型 色 { 赤, 緑 }
列挙型 結 { 良(整32), 悪(文字列), 空 }
構造体 札 { 色: 色, 結: 結 }

関数 値(r: 結) -> 整32 {
    照合 r {
        結::良(n) => 返却 n,
        結::悪(_) => 9,
        結::空 => 0,
    }
}

関数 次(c: 色) -> 色 {
    照合 c { 色::赤 => 色::緑, 色::緑 => 色::赤 }
}

関数 主() {
    束縛 可変 c = 色::赤;
    各 i 中 0..5 {
        c = 次(c);
        照合 c {
            色::赤 => 続行,
            色::緑 => { 表示!("緑 {}", i); }
        }
        もし i == 3 { 中断; }
    }
    束縛 t = 札 { 色: c, 結: 結::良(5) };
    照合 t.結 {
        結::良(n) => 表示!("{}", n + 1),
        結::悪(m) => 表示!("{}", m),
        結::空 => {}
    }
    照合 3 { 1 => {}, _ => {}, 2 => {} }
    照合 c { 色::赤 => {}, 色::緑 => {}, 色::赤 => {} }
    束縛 未使用 = 照合 c { 色::赤 => 1, 色::緑 => 2 };
}
